# Meta app credentials — NEVER commit your real secrets.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_VERSION=v26.0

# Use the public HTTPS URL of your Codespace/app.
# Example: https://your-codespace-url.app.github.dev
APP_BASE_URL=https://YOUR-CODESPACE-URL.app.github.dev

# Random secret used to sign the local session cookie.
SESSION_SECRET=replace_with_a_long_random_string

PORT=3000
